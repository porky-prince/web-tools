{
  "name": "es-stl",
  "version": "2.0.0",
  "description": "ECMAScript Standard Template Library",
  "author": "Porky Ke",
  "homepage": "https://github.com/porky-prince/web-tools/packages/es-stl#readme",
  "bugs": "https://github.com/porky-prince/web-tools/issues",
  "license": "MIT",
  "sideEffects": false,
  "react-native": "./dist/index.js",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:porky-prince/web-tools.git",
    "directory": "packages/es-stl"
  },
  "scripts": {
    "start": "npm-run-all -l -p watch:*",
    "watch:js": "vite build --watch",
    "watch:types": "tsc --declaration --emitDeclarationOnly -w",
    "build:js": "vite build",
    "build:types": "tsc --declaration --emitDeclarationOnly",
    "build": "del dist && npm-run-all -l build:js build:types",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch",
    "test": "jest"
  },
  "dependencies": {},
  "devDependencies": {},
  "keywords": [
    "data-structure",
    "algorithm",
    "ds",
    "algo",
    "stl"
  ]
}
